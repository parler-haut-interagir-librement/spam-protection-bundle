{
    "name": "phil/spam-protection-bundle",
    "description": "phil/spam-protection in Symfony: keep spam out of your forms without a captcha, a third party or tracking, through checks a person never sees.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "spam",
        "honeypot",
        "form",
        "symfony",
        "proof-of-work",
        "privacy"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-filter": "*",
        "ext-sodium": "*",
        "phil/bot-detection-bundle": "^0.1@dev",
        "phil/rate-limit": "^0.1.1@dev",
        "phil/spam-protection": "^0.1@dev",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/translation-contracts": "^3.8"
    },
    "require-dev": {
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "doctrine/dbal": "^4.6",
        "doctrine/orm": "^3.8",
        "phpunit/phpunit": "^13.4",
        "symfony/cache": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/process": "^8.2",
        "symfony/rate-limiter": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/translation": "^8.2"
    },
    "suggest": {
        "doctrine/dbal": "To keep the used tokens in a table, single-use atomically",
        "symfony/lock": "To keep the used tokens in a cache pool, single-use atomically under a lock",
        "symfony/rate-limiter": "To limit the submissions of one client to one form"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\SpamProtectionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\SpamProtectionBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    }
}
