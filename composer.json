{
    "name": "phil/spam-protection-bundle",
    "description": "Spam protection for Symfony forms without captcha, third party or identifier: honeypot, signed single-use token, filling time, browser proof of work, text rules and rate limit, whose outcome is a phil/bot-detection-bundle verdict",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "spam",
        "honeypot",
        "form",
        "symfony",
        "proof-of-work",
        "privacy"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-filter": "*",
        "ext-sodium": "*",
        "phil/bot-detection-bundle": "^0.1@dev",
        "phil/spam-protection": "^0.1@dev",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/translation-contracts": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/cache": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/rate-limiter": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/translation": "^8.2"
    },
    "suggest": {
        "symfony/rate-limiter": "To limit the submissions of one client to one form"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\SpamProtectionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\SpamProtectionBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
